Options -Indexes
DirectoryIndex index.php

# the data folder (database, uploads) and the app code are never served directly
RedirectMatch 404 ^/data/
RedirectMatch 404 ^/app/

RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} !^localhost
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

# real files (photos, css, fonts, video) are served as they are; everything else is a page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/(_next/static|projects|brand|video|assets)/" BK_STATIC=1
  Header always set Cache-Control "public, max-age=31536000, immutable" env=BK_STATIC
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
