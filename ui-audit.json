{
  "name": "studio-baikal",
  "build": "npm run build",
  "start": "npx next start -p 3901",
  "url": "http://localhost:3901",
  "widths": [
    336,
    375,
    414,
    768,
    1024,
    1280
  ],
  "fullWidths": [
    336
  ],
  "ignore": [
    ".arch-mask img",
    ".asm",
    ".bubbles",
    ".caustic",
    ".cmp img",
    ".cmp-tag",
    ".cold",
    ".d2b-built",
    ".d2b-drawn img",
    ".d2b-half",
    ".d2b-line",
    ".dg-marker",
    ".glow-lamp",
    ".h-img",
    ".h-stage",
    ".ken",
    ".lens-pan",
    ".ph-img",
    ".room-tag",
    ".rt-scene",
    ".rt-scene img",
    ".sr-only",
    ".st-img",
    ".tilt",
    "[aria-hidden=\"true\"]"
  ],
  "pages": [
    "/en",
    "/ar",
    "/en/projects",
    "/en/services",
    "/en/studio",
    "/en/contact",
    "/ar/services",
    "/en/projects/el-nakhil-villa",
    "/en/projects/maadi-285",
    "/ar/projects/october-250"
  ],
  "states": [
    {
      "page": "/en",
      "name": "menu",
      "click": "button[aria-label=Menu]",
      "maxWidth": 1023
    },
    {
      "page": "/ar",
      "name": "menu-ar",
      "click": "header button[aria-expanded]",
      "maxWidth": 1023
    }
  ]
}