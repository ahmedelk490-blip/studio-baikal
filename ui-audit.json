{
  "name": "studio-baikal",
  "build": "npm run build",
  "start": "npx next start -p 3901",
  "url": "http://localhost:3901",
  "widths": [
    336,
    375,
    414,
    768,
    1024,
    1280
  ],
  "fullWidths": [
    336
  ],
  "ignore": [".bk-frame", ".bk-fig", ".bk-meta",
    "#projects [dir=ltr] > div > a",
    "#projects [dir=ltr] > div > a *",
    ".ap-hero",
    ".arch-mask img",
    ".arch-slide",
    ".asm",
    ".bubbles",
    ".cascade > div",
    ".caustic",
    ".cmp img",
    ".cmp-tag",
    ".cold",
    ".d2b-built",
    ".d2b-drawn img",
    ".d2b-half",
    ".d2b-line",
    ".dg-marker",
    ".glow-lamp",
    ".h-img",
    ".h-stage",
    ".ken",
    ".lens-pan",
    ".ph-img",
    ".ph-hero",
    ".room-tag",
    ".rt-scene",
    ".rt-scene img",
    ".sr-only",
    ".st-card",
    ".st-img",
    ".tilt",
    "[aria-hidden=\"true\"]"
  ],
  "pages": [
    "/en",
    "/ar",
    "/en/projects",
    "/en/services",
    "/en/studio",
    "/en/contact",
    "/ar/services",
    "/en/projects/el-nakhil-villa",
    "/en/projects/maadi-285",
    "/ar/projects/october-250"
  ],
  "states": [
    {
      "page": "/en",
      "name": "menu",
      "steps": [{ "wait": 1500 }, { "click": "header button[aria-expanded]" }, { "wait": 900 }],
      "maxWidth": 1023
    },
    {
      "page": "/ar",
      "name": "menu-ar",
      "steps": [{ "wait": 1500 }, { "click": "header button[aria-expanded]" }, { "wait": 900 }],
      "maxWidth": 1023
    }
  ]
}