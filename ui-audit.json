{
  "name": "studio-baikal",
  "build": "npm run build",
  "start": "npx next start -p 3901",
  "url": "http://localhost:3901",
  "widths": [
    336,
    375,
    414,
    768,
    1024,
    1280
  ],
  "fullWidths": [
    336
  ],
  "ignore": [
    ".bubbles",
    ".caustic",
    ".dg-marker",
    ".h-img",
    ".h-stage",
    ".ken",
    ".lens-pan",
    ".ph-img",
    ".rt-scene",
    ".rt-scene img",
    ".sr-only",
    ".st-img",
    "[aria-hidden=\"true\"]"
  ],
  "pages": [
    "/en",
    "/ar",
    "/en/projects/el-nakhil-villa",
    "/ar/projects/el-nakhil-villa",
    "/en/projects/ca-dental-clinic"
  ],
  "states": [
    {
      "page": "/en",
      "name": "menu",
      "click": "button[aria-label=Menu]",
      "maxWidth": 767
    },
    {
      "page": "/ar",
      "name": "menu-ar",
      "click": "header button[aria-expanded]",
      "maxWidth": 767
    }
  ]
}